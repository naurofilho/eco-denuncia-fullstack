# Copie para .env e ajuste. O .env não vai para o Git.

# 1 = desenvolvimento. Em produção use 0 e defina uma DJANGO_SECRET_KEY longa e aleatória.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Endereços do frontend que podem chamar a API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Banco de dados. Sem POSTGRES_DB, usa SQLite (arquivo db.sqlite3).
# POSTGRES_DB=ecodenuncia
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
