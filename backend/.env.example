# Copie para .env e ajuste. O .env não vai para o Git.

# 1 = desenvolvimento. Em produção use 0 e defina uma DJANGO_SECRET_KEY longa e aleatória.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Endereços do frontend que podem chamar a API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Banco de dados. Sem DATABASE_URL nem POSTGRES_DB, usa SQLite (arquivo db.sqlite3).
# Endereço completo, como o que o Neon mostra:
# DATABASE_URL=postgresql://usuario:senha@servidor/banco?sslmode=require
# Ou as partes separadas:
# POSTGRES_DB=ecodenuncia
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Fotos. Sem FOTOS_BUCKET, ficam na pasta media/. Com ele, num bucket compatível com S3
# (Cloudflare R2, AWS S3), e a API entrega links assinados que valem 1 hora.
# FOTOS_BUCKET=eco-denuncia-fotos
# FOTOS_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
# FOTOS_ACCESS_KEY_ID=
# FOTOS_SECRET_ACCESS_KEY=

# Administrador criado pelo comando "python manage.py criar_admin", usado no build do Render.
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
